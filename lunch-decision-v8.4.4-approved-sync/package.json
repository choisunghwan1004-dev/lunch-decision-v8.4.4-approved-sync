{
  "name": "lunch-decision-v8-4-integrated",
  "version": "8.4.4",
  "private": true,
  "main": "server.js",
  "scripts": {
    "backup": "node scripts/backup.js",
    "setup": "node scripts/setup.js",
    "seed:demo": "npm run seed:base && node scripts/seed-integration.js && npm run seed:travel",
    "migrate:plan": "node scripts/migrate.js --plan",
    "migrate:apply": "node scripts/migrate.js --apply",
    "verify": "node scripts/verify.js",
    "test:ui": "node --test tests/*.test.js",
    "start": "node server.js",
    "docs:news": "node scripts/update-news-readme.js",
    "docs:news:check": "node scripts/update-news-readme.js --check",
    "test:docs": "node --test tests/news-readme.test.js",
    "precheck": "npm run docs:news",
    "check": "node --check server.js && node --check routes/api.js && node --check scripts/migrate.js && node --check scripts/backup.js && node --check routes/news-proxy.js && node --check public/news-admin.js && node --check public/news-public.js",
    "seed:base": "node scripts/seed-demo.js",
    "test:api": "node scripts/test-api.js",
    "doctor": "node scripts/doctor.js",
    "seed:travel": "node scripts/seed-travel-50.js",
    "verify:travel": "node scripts/verify-travel.js",
    "test:map": "node --test tests/map-v843.test.js",
    "setup:sync": "node scripts/setup-google-sync.js",
    "test:sync": "node --test tests/sync-v844.test.js",
    "news:setup": "python -m news_service.setup --init-env",
    "news:run": "python -m uvicorn news_service.app:app --host 127.0.0.1 --port 8001",
    "news:test": "python -m pytest tests/news -q",
    "test:news-proxy": "node --test tests/news-proxy.test.js",
    "news:doctor": "node scripts/news-ui-doctor.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "mysql2": "^3.14.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
